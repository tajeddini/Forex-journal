# Supabase browser client configuration
# Use the publishable key only. Never put a service_role/secret key in VITE_* variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional legacy variable name for older local setups:
# VITE_SUPABASE_ANON_KEY="..."

# AI Server Configuration (Phase 13 - NEVER prefix with VITE_)
# Set these in your Vercel Project Settings > Environment Variables
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
AI_API_KEY="YOUR_GEMINI_OR_AI_API_KEY"
AI_PROVIDER="gemini" # Options: gemini | openai | qwen | mock
AI_MODEL="gemini-3.8-flash" # e.g. gemini-3.8-flash | gpt-4o-mini | qwen-plus
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
QWEN_API_KEY="YOUR_QWEN_API_KEY"
APP_URL="https://your-production-domain.vercel.app"
GITHUB_CLIENT_ID="MY_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="MY_GITHUB_CLIENT_SECRET"
